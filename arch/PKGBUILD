# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-filetransfer
pkgver=1.2.1
pkgrel=1
pkgdesc='GXDE file transfer client'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-filetransfer"
license=('GPL-3.0-or-later')
# 传输通过 curl 进行，与 debian/control 相同 ・ Transfers go through curl, as in debian/control.
depends=('dtk2widget-qt6' 'gxde-dtk6core' 'qt6-base' 'curl' 'hicolor-icon-theme' 'libgcc' 'libstdc++'
         'glibc')
makedepends=('git' 'pkgconf' 'qt6-tools')
provides=("gxde-filetransfer-git=$pkgver")
conflicts=('gxde-filetransfer-git')
replaces=('gxde-filetransfer-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  mkdir -p build
  cd build
  qmake6 "$(_srcroot)/remote-file-dtk2.pro" \
    PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  make -C build INSTALL_ROOT="$pkgdir" install
}
